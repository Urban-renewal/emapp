{
  "name": "@emapp/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsx scripts/gen-api-docs.ts --check && nest build",
    "start": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "bootstrap:provider": "tsx scripts/bootstrap-provider-admin.ts",
    "gen:api-docs": "tsx scripts/gen-api-docs.ts",
    "gen:api-docs:check": "tsx scripts/gen-api-docs.ts --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@emapp/config": "workspace:*",
    "@emapp/db": "workspace:*",
    "@emapp/jobs": "workspace:*",
    "@emapp/shared-types": "workspace:*",
    "@emapp/validators": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^12.0.0",
    "@fontsource/heebo": "^5.2.8",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^8.0.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "ical-generator": "^10.2.0",
    "nestjs-pino": "^4.1.0",
    "otpauth": "^9.3.4",
    "pg-boss": "^10.3.2",
    "pino-http": "^10.0.0",
    "playwright-core": "^1.60.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.24",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.0.0",
    "@types/webpack-node-externals": "^3.0.4",
    "adm-zip": "^0.5.17",
    "fastify": "^5.0.0",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.22.4",
    "vitest": "^2.1.9",
    "webpack-node-externals": "^3.0.0"
  }
}
