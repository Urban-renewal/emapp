# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@ep-xxxxx.eu-central-1.aws.neon.tech/db?sslmode=require

# Provider tier DB user (separate role with BYPASSRLS — see Doc 04c P1.3)
DATABASE_URL_PROVIDER=postgresql://provider_app_role:pass@ep-xxxxx.eu-central-1.aws.neon.tech/db?sslmode=require

# Cache: PostgresCacheProvider uses cache_kv table in DATABASE_URL — no separate REDIS_URL in MVP.
# When migrating to Upstash Redis in Growth phase, add: UPSTASH_REDIS_URL=rediss://...

# S3-compatible storage (Cloudflare R2)
S3_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=xxxxx
S3_SECRET_ACCESS_KEY=xxxxx
S3_BUCKET=urban-renewal-dev

# Email (Resend)
RESEND_API_KEY=re_xxxxx

# Monitoring (Sentry)
SENTRY_DSN_API=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_DSN_WEB=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# PII encryption (two separate keys — see Doc 07 §5)
PII_ENCRYPTION_KEY=  # 32+ char random string for pgp_sym_encrypt
PII_HASH_KEY=        # 32+ char random string for HMAC (separate from encryption key)

# Auth (Better Auth)
BETTER_AUTH_SECRET=  # 32+ char random string
BETTER_AUTH_URL=http://localhost:3000

# Phase 5 signature-link tokens (docs/03 §9). SEPARATE from JWT_SECRET — a
# leak of one must not compromise the other (different TTLs + threat models).
# 44+ chars base64url. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SIGNATURE_TOKEN_SECRET=  # 44+ char random string

# App config
NODE_ENV=development
LOG_LEVEL=debug
PORT_API=3000
PORT_WEB=3001

# Public self-service signup (owner-approved, refines D.21). INACTIVE by default:
# the active onboarding path is provider-led (POST /provider/tenants → invite
# first manager → /auth/accept-invite). Set to '1' to re-enable POST /auth/signup
# (server) AND the signup link/page (web). Anything else = signup route returns
# 404 + FE link hidden + /signup redirects to /login. The signup code + D.21
# withBootstrap are RETAINED — just unreachable while off.
# See docs/decision-records/disable-public-signup.md
PUBLIC_SIGNUP_ENABLED=0
NEXT_PUBLIC_SIGNUP_ENABLED=0

# Global campaign-send kill-switch (E2 Wave-0 N15). OPT-OUT: campaign fan-out
# is ENABLED by default; set to 0 (or false) to disable the project-wide
# signature-campaign send without a redeploy. Unset/anything-else = enabled.
CAMPAIGN_SEND_ENABLED=1
