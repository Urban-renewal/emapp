{
  "name": "@emapp/worker",
  "version": "0.0.1",
  "private": true,
  "description": "EMAPP background worker — pg-boss job consumer (Phase 6 Excel import + future jobs). Runs as a separate Railway service from @emapp/api per docs/02 §354 + docs/03 §1424.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "echo 'worker uses tsx at runtime — no separate build'",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@emapp/config": "workspace:*",
    "@emapp/db": "workspace:*",
    "@emapp/jobs": "workspace:*",
    "@emapp/shared-types": "workspace:*",
    "@emapp/validators": "workspace:^",
    "@sentry/node": "^8.0.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "pg-boss": "^10.1.5",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.0",
    "vitest": "^4.1.9"
  }
}
