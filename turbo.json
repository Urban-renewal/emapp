{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "SKIP_ENV_VALIDATION",
    "DEV_AUTH_BYPASS",
    "PUBLIC_SIGNUP_ENABLED",
    "NEXT_PUBLIC_SIGNUP_ENABLED",
    "DATABASE_URL",
    "PROVIDER_DATABASE_URL",
    "PII_ENCRYPTION_KEY",
    "PII_HASH_KEY",
    "BETTER_AUTH_SECRET",
    "JWT_SECRET",
    "SIGNATURE_TOKEN_SECRET",
    "API_BACKEND_URL",
    "RESEND_API_KEY",
    "DATABASE_MIGRATE_URL",
    "R2_ENDPOINT",
    "R2_BUCKET",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
