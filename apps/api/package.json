    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@sentry/node": "^8.0.0",
    "drizzle-orm": "^0.36.0",
    "nestjs-pino": "^4.1.0",
    "pino-http": "^10.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^25.8.0",
    "@types/webpack-node-externals": "^3.0.4",
