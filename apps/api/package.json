{
  "name": "@emapp/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsx scripts/gen-api-docs.ts --check && nest build",
    "start": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "bootstrap:provider": "tsx scripts/bootstrap-provider-admin.ts",
    "gen:api-docs": "tsx scripts/gen-api-docs.ts",
    "gen:api-docs:check": "tsx scripts/gen-api-docs.ts --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@emapp/config": "workspace:*",
    "@emapp/db": "workspace:*",
    "@emapp/jobs": "workspace:*",
    "@emapp/shared-types": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@nestjs/common": "^11.1.23",
    "@nestjs/core": "^11.1.23",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.23",
    "@nestjs/throttler": "^6.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^10.53.1",
    "drizzle-orm": "^0.45.2",
    "nestjs-pino": "^4.1.0",
    "otpauth": "^9.3.4",
    "pg-boss": "^12.18.2",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^20.0.0",
    "@types/webpack-node-externals": "^3.0.4",
    "fastify": "^5.0.0",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.9",
    "webpack-node-externals": "^3.0.0"
  }
}
