{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@emapp/shared-types": ["packages/shared-types/src"],
      "@emapp/db": ["packages/db/src"],
      "@emapp/config": ["packages/config/src"],
      "@emapp/validators": ["packages/validators/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".turbo"]
}
